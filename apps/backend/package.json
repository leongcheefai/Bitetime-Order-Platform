{
  "name": "@bitetime/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TinyOrder billing backend — Hono + Stripe + Supabase",
  "scripts": {
    "dev": "node --import jiti/register --watch --env-file=.env src/index.ts",
    "start": "node dist/server.js",
    "build": "esbuild src/index.ts --bundle --external:@anthropic-ai/sdk --external:@hono/node-server --external:hono --external:@supabase/supabase-js --external:stripe --external:postgres --external:exceljs --external:pinyin-pro --external:pdf-lib --external:fontkit --external:qrcode --platform=node --format=esm --target=node20 --outfile=dist/server.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && mkdir -p dist/assets && cp src/assets/NotoSansSC.ttf dist/assets/NotoSansSC.ttf",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "supabase migration up",
    "db:push": "supabase db push",
    "db:seed:superadmin": "./scripts/seed-superadmin.sh",
    "screenshot:sweep": "node --experimental-strip-types scripts/captureSampleShopScreenshots.ts",
    "release:version": "node --import jiti/register scripts/nextVersion.ts",
    "telegram:webhook": "node --import jiti/register --env-file=.env scripts/telegramWebhook.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@bitetime/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@supabase/supabase-js": "^2.107.0",
    "exceljs": "^4.4.0",
    "fontkit": "^2.0.4",
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "pinyin-pro": "^3.28.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "playwright": "^1.62.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.6"
  }
}
