# BiteTime billing server — copy to .env and fill in.

PORT=8787
FRONTEND_URL=http://localhost:5173

# Stripe (test mode keys for local dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — service role key is secret, server-only. Anon key verifies caller JWTs.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=...
SUPABASE_SERVICE_ROLE_KEY=...

# Direct Postgres connection, for the rules that need a real transaction (supabase-js has
# none). RLS does NOT apply on this connection — it authenticates as the database owner —
# so anything using it enforces tenancy in TypeScript. Locally this is `DB_URL` from
# `supabase status`; in production it is the project's connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Stripe Price IDs (MYR). One plan, so one product with two recurring prices — see README.
# Both are required; the backend refuses to start without them.
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Resend (trial-reminder emails). Optional locally: unset = emails are skipped.
# Production needs a verified sending domain in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM=BiteTime <billing@yourdomain.com>

# Google Maps Platform (Routes + Places), on the platform's account, never a merchant's.
# Optional: unset = distance lookups fail closed.
GOOGLE_MAPS_API_KEY=

# GitHub (auto-files merchant feedback as issues on leongcheefai/Bitetime-Order-Platform).
# Fine-grained PAT, issues:write on that one repo. Optional: unset = issue creation is
# skipped, feedback still saves normally.
GITHUB_TOKEN=

# Anthropic (rewrites raw GitHub release notes into merchant-facing copy, see releases.ts).
# Optional: unset = humanization is skipped and logged, the pulled release still saves with
# humanize_error set.
ANTHROPIC_API_KEY=

# Signs the merchant email-verification link (emailVerifyToken.ts). Any long random string —
# `openssl rand -hex 32`. Optional: unset = no address-check mail is sent and the dashboard
# banner never appears. Signup itself never depends on it.
# CHANGING IT INVALIDATES every link already in a merchant's inbox; they ask for a new one.
EMAIL_VERIFY_SECRET=

# Shared secret for POST /api/internal/releases-pull, called by .github/workflows/release.yml
# the moment it cuts a tag. Any long random string — `openssl rand -hex 32` — and the same
# value must be a GitHub repo secret named RELEASE_PULL_SECRET. Optional: unset = the endpoint
# refuses (503) and a superadmin pulls the release by hand from /admin.
RELEASE_PULL_SECRET=

# The PLATFORM's own Telegram chat — where the superadmin hears that a shop signed up.
# A PAIR, and either one missing turns the alert off. Get the token from @BotFather, then
# read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates after you message the
# bot (a group id starts with -100). This is NOT a merchant's order bot; that token lives in
# merchant_secrets, per shop. Optional: unset = the alert is skipped and logged, and signup
# is unaffected.
PLATFORM_TG_TOKEN=
PLATFORM_TG_CHAT_ID=
